#!/usr/bin/env bash
# Roadmap task T182b, D1: a change to what goes into the privileged helper must bump
# HELPER_VERSION, and this is where it is noticed first, before the commit exists.
#
# Enabled once per clone with `git config core.hooksPath .githooks`. It runs the check only when a
# staged file is one the helper is built from (the list helper.lock keeps), or Cargo.lock, so every
# other commit pays nothing for it.

set -euo pipefail

root="$(git rev-parse --show-toplevel)"
lock="$root/crates/mixengine-elevate/helper.lock"

[ -f "$lock" ] || exit 0

staged="$(git diff --cached --name-only)"
[ -n "$staged" ] || exit 0

helper_files="$(node -e '
  const lock = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
  process.stdout.write(lock.files.join("\n"));
' "$lock")"

concerns_the_helper=false
if printf '%s\n' "$staged" | grep -qx 'Cargo.lock'; then
  concerns_the_helper=true
elif printf '%s\n' "$staged" | grep -qxF -f <(printf '%s\n' "$helper_files"); then
  concerns_the_helper=true
fi

if [ "$concerns_the_helper" = true ]; then
  exec bash "$root/packaging/helper-lock.sh" --check
fi
