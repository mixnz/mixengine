/target/
**/node_modules/
/apps/desktop/dist/
/apps/desktop/src-tauri/target/

# Local sandbox roots used while experimenting with MIXENGINE_HOME
/.mixengine-home/
*.db
*.db-shm
*.db-wal

# …except the frozen upgrade fixtures (T89), which are the only `mixengine.db` in this repository
# that is meant to be here. Without this line the rule above silently drops them from every commit —
# `git add` says nothing, the directory is empty on a fresh clone, and the suite that migrates them
# passes having read nothing.
!crates/mixengine-testkit/fixtures/upgrade/*.db

.DS_Store
Thumbs.db

# Implementation plans — local working notes for one stretch of work, never shared or referenced.
# The design document that outlives the branch is its spec, under docs/specs/.
docs/plans/

# The server's two toolchains (ADR 0046). `server/native/` is a Cargo workspace of its own, and
# `.wrangler/` is where a local `wrangler dev` keeps the Durable Object's SQLite files.
/server/native/target/
/server/worker/.wrangler/
