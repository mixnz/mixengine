# Generated by MixEngine for the site at {{ primary }}. Every edit here is overwritten on the next
# render; what you change is the site itself, with `mix site update`.
#
# **The scheme is written out on every address.** A bare `blog.test` is an HTTPS site to Caddy, and
# it would try to obtain a certificate for a name that is not reachable from anywhere. The global
# block already says `auto_https off` for that reason; saying it here too means a change to that
# setting cannot silently alter what a site means.
#
# **No port.** The global block's `http_port` and `https_port` are what these are served on, which is
# what lets one rendering be right on a system that redirects 80 to 8080 and on the two that do not.
{%- if certificate %}
#
# Certificate sha256:{{ certificate.fingerprint }}
#
# That line is not a note. It exists so that this file differs when the certificate differs: a
# certificate is reissued to the same path, so without it a renewed certificate renders
# byte-identical bytes, `document::install` compares them, finds no change, and nobody is ever asked
# to re-read anything. Delete it and a reissued certificate is never served.
#
# **It is not enough on its own, and the second half is in the recipe.** `caddy reload` adapts this
# file to JSON and the adapter throws comments away, so the configuration Caddy is handed after a
# reissue is identical to the one it is already running — which its admin endpoint answers by
# skipping the load. `--force` on the reload command is what makes this line reach the server, and it
# took a rotation on CI's Windows and macOS legs to find that out.
{%- endif %}
{% for domain in domains %}http://{{ domain }}{% if not loop.last %}, {% endif %}{% endfor %}{% if lan %}, http://{{ lan }}{% endif %}{% if mdns %}, http://{{ mdns }}{% endif %} {
	# **Which addresses this site listens on** — roadmap task T74. Caddy's own default is every
	# interface, so this line is what keeps an unshared site off the network: loopback and nothing
	# else. A shared site has its interface address appended, and the block's address list above
	# carries that address as a name so a phone sending `Host: 192.0.2.10:8080` (RFC 5737, so a test can assert on a real one) matches this site
	# rather than nothing at all.
	#
	# **And its mDNS name beside the address** — roadmap task T75. The daemon advertises
	# `<slug>-mixengine.local` on the network; this block's address list is what makes the site
	# *reply* to it. Two questions, and T74 paid a phone to learn that they are two.
	#
	# **Both loopback families.** `blog.test` arrives on 127.0.0.1 through the hosts file, and
	# `localhost` arrives on ::1 first on Windows; `bind` replaces the default rather than adding to
	# it, so naming one would break whichever the developer typed.
	#
	# **Outside the `handle` blocks below**, because it is a server option rather than a handler: it
	# says where connections are accepted, not what answers them.
	bind {% for address in bind %}{{ address }}{% if not loop.last %} {% endif %}{% endfor %}
{%- if authority %}

	# **This home's certificate authority, for a phone that has to install it** — roadmap task T75.
	# A private CA cannot be trusted by a device that has not installed it; handing it over is the
	# honest path, and the alternative is telling somebody to click through a warning.
	#
	# **The root is the rendered copy and never `certs/ca/`**, which holds the signing key beside
	# the certificate. Pointing a file server at that directory would publish this home's authority
	# key to the local network — the single most dangerous line this file could contain. The copy's
	# directory holds exactly one file, so what stops that is the layout rather than this matcher
	# being written correctly.
	#
	# **The content type is not decoration.** Without it iOS does not offer to install a profile and
	# Android does not recognise the file, which leaves the endpoint useless.
	handle /__mixengine/ca.crt {
		root * `{{ authority }}`
		rewrite * /ca.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}

	# Everything else this site serves. `handle` blocks are mutually exclusive and taken in order,
	# so the route above is not something a site's own files can shadow.
	handle {
{%- endif %}
{%- if https_redirect and certificate %}

	# Every request but the CA route above (when there is one) goes straight to HTTPS — opted into
	# per site, roadmap task T98. `{host}` and `{uri}` are the request's own, not this site's
	# `domains` list, so an alias and the LAN address each redirect to the scheme on the name they
	# were reached by rather than to the primary domain's — which a name the certificate's SANs do
	# not cover would otherwise send every other name into.
	#
	# **307 and never `permanent`.** This is a setting a site can turn off as freely as it was
	# turned on, and a browser that has cached a `301` as permanent goes on redirecting locally
	# after that — never asking this server again, and never noticing it stopped saying so. 307
	# also carries a request's method and body across the redirect unchanged, where 301 and 302
	# both leave a POST arriving as a GET on the other side in some client, which is the exact
	# failure T51's D9 gave as the reason this whole feature defaults to off.
	redir https://{host}{uri} 307
{%- else %}
	# Backticks and not quotes, on every path this file writes: a Caddyfile token in double quotes
	# processes `\"` and `\\` as escapes, so `C:\src\blog` ends the string one character early and
	# the parse error names the line after it.
	root * `{{ doc_root }}`
{%- if kind == "php-fpm" %}
{%- if welcome %}
	# **A site with nothing in it says so, instead of answering 404** — roadmap task T124.
	#
	# **A matcher that asks the disk, and never ordering alone.** `php_fastcgi` expands to a
	# `try_files` whose last entry is a fallback to `index.php`, so `/` can reach the pool whether
	# or not that file is there; and `php_fastcgi` is not in the mutually exclusive group `handle`
	# blocks form, so a route placed after it is not reliably reached either. Both are removed by
	# putting the whole condition in the matcher and the route first. What is measured is the
	# outcome rather than the mechanism — `crates/mixengine-cli/tests/welcome.rs`, against Caddy
	# 2.11.4 and PHP 8.4.24: 200 and this page at `/`, 404 at `/missing` and `/api/anything`, and
	# the site's own index answering the moment it is written, with no reload.
	#
	# **`path /` and `not file`, together.** An application's own 404 is an answer, and replacing
	# it would be MixEngine lying about somebody else's program — a site serving a JSON API under
	# `/api` and nothing at `/` is ordinary. This matches one exact path, and only while the disk
	# holds none of the index files the site would have served, so a site with one never renders
	# this page even once.
	#
	# `no-store`, because a browser that cached this at `/` would go on showing it after the index
	# that replaced it was written — the site looking broken in exactly the way this page exists
	# to prevent.
	@mixengine_welcome {
		path /
		not file {
			try_files index.php index.html index.htm
		}
	}
	handle @mixengine_welcome {
		root * `{{ welcome }}`
		rewrite * /{{ primary }}.html
		header Cache-Control "no-store"
		file_server
	}
{%- endif %}

	handle {

	# The pool this site's project resolves to, at the address that pool's own recipe says it
	# listens on. `php_fastcgi` sets every `fastcgi_param` PHP needs itself, which is why this
	# template includes nothing and nginx's has to.
{%- if activator %}
	#
	# **The second address is the activator, and the three directives under it are one unit** —
	# roadmap task T70. Measured against Caddy 2.10.0 with the pool's address dead, twenty requests
	# each: both addresses and nothing else answers 8 of 20, because Caddy treats them as peers and
	# load-balances between them, so a bare pair sends half of a *healthy* site's traffic through the
	# activator. `lb_policy first` with a retry budget and no `fail_duration` answers 0 of 20, each
	# burning the whole budget, because nothing ever marks the refusing pool unavailable and `first`
	# goes on choosing it. All three together answer 20 of 20.
	php_fastcgi {{ upstream }} {{ activator }} {
		# The pool whenever it is up; the activator only once the pool has refused.
		lb_policy first

		# One request's patience. The activator starts the pool inside this or the request fails,
		# which is a 502 either way and is at least a fast one.
		lb_try_duration 5s
		lb_try_interval 50ms

		# How long a refusal is remembered, and therefore how long a *recovered* pool is still
		# reached the slow way — measured exactly, to the second. Short because a pool starts in well
		# under one: re-probing one that is still starting costs a retry the budget above already
		# covers, while a long memory keeps a warm pool behind a proxy hop for nothing.
		fail_duration 3s
	}
{%- else %}
	php_fastcgi {{ upstream }}
{%- endif %}
	file_server
	}
{%- elif kind == "static" %}
{%- if welcome %}
	# The same route a php-fpm site gets, with the index files a static site would have
	# served — roadmap task T124. `file_server` has the same shape of problem `php_fastcgi`
	# does: it is not in the group `handle` blocks form, so the condition has to be the
	# matcher's rather than the ordering's.
	@mixengine_welcome {
		path /
		not file {
			try_files index.html index.htm
		}
	}
	handle @mixengine_welcome {
		root * `{{ welcome }}`
		rewrite * /{{ primary }}.html
		header Cache-Control "no-store"
		file_server
	}
{%- endif %}

	handle {
		file_server
	}
{%- else %}
	reverse_proxy {{ upstream }}

{%- if welcome %}
	# **Nothing listening is answered rather than reported as a gateway error** — roadmap task
	# T124. `SiteKind::NodeApp` is a declaration and no more: nothing in this build starts
	# `npm run dev`, so a site on a machine that has just booted reaches this every single time.
	# What cannot be removed is the 502; what can be removed is the silence around it.
	#
	# **Every path, unlike the `handle /` the file kinds get.** A 502 Caddy generated means nothing
	# was listening, so there is no application whose answer this could be overwriting — and the
	# matcher names the two statuses rather than catching everything, so an upstream that is up and
	# said 404 still says 404.
	handle_errors 502 504 {
		root * `{{ welcome }}`
		rewrite * /{{ primary }}.html
		header Cache-Control "no-store"
		file_server
	}
{%- endif %}
{%- endif %}
{%- endif %}
{%- if authority %}
	}
{%- endif %}
}
{%- if certificate %}

# **A second block, and not a second scheme on the first** — the T51 design, D2. A `tls` directive
# applies to every listener its block produces, and Caddy refuses a block that has a plaintext
# listener and a TLS policy both:
#
#     server listening on [:80] is HTTP, but attempts to configure TLS connection policies
#
# So the handler below is repeated rather than shared. A Caddyfile snippet would remove the
# repetition and is not taken: a snippet lives in the Caddyfile, which is the one document that must
# hold nothing belonging to a single site — that is what makes a broken site take only itself down.
{% for domain in domains %}https://{{ domain }}{% if not loop.last %}, {% endif %}{% endfor %}{% if lan %}, https://{{ lan }}{% endif %}{% if mdns %}, https://{{ mdns }}{% endif %} {
	# The same addresses as the plaintext block above, for the same reason — T74. A shared site that
	# answered on the LAN over HTTP and only on loopback over HTTPS would be a padlock that works
	# everywhere except the device it was shared for.
	bind {% for address in bind %}{{ address }}{% if not loop.last %} {% endif %}{% endfor %}

	# Signed by this home's own authority — roadmap task T50. `auto_https off` in the global block is
	# what stops Caddy trying to obtain one of its own for a name nothing public resolves.
	tls `{{ certificate.certificate }}` `{{ certificate.key }}`
{%- if authority %}

	# The authority over TLS as well — roadmap task T75. A device that has not installed it cannot
	# reach this block at all, so the plaintext route above is the one that matters; this exists so
	# that the path does not 404 on whichever scheme somebody happens to try.
	handle /__mixengine/ca.crt {
		root * `{{ authority }}`
		rewrite * /ca.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}

	handle {
{%- endif %}
	root * `{{ doc_root }}`
{%- if kind == "php-fpm" %}
{%- if welcome %}
	# **A site with nothing in it says so, instead of answering 404** — roadmap task T124.
	#
	# **A matcher that asks the disk, and never ordering alone.** `php_fastcgi` expands to a
	# `try_files` whose last entry is a fallback to `index.php`, so `/` can reach the pool whether
	# or not that file is there; and `php_fastcgi` is not in the mutually exclusive group `handle`
	# blocks form, so a route placed after it is not reliably reached either. Both are removed by
	# putting the whole condition in the matcher and the route first. What is measured is the
	# outcome rather than the mechanism — `crates/mixengine-cli/tests/welcome.rs`, against Caddy
	# 2.11.4 and PHP 8.4.24: 200 and this page at `/`, 404 at `/missing` and `/api/anything`, and
	# the site's own index answering the moment it is written, with no reload.
	#
	# **`path /` and `not file`, together.** An application's own 404 is an answer, and replacing
	# it would be MixEngine lying about somebody else's program — a site serving a JSON API under
	# `/api` and nothing at `/` is ordinary. This matches one exact path, and only while the disk
	# holds none of the index files the site would have served, so a site with one never renders
	# this page even once.
	#
	# `no-store`, because a browser that cached this at `/` would go on showing it after the index
	# that replaced it was written — the site looking broken in exactly the way this page exists
	# to prevent.
	@mixengine_welcome {
		path /
		not file {
			try_files index.php index.html index.htm
		}
	}
	handle @mixengine_welcome {
		root * `{{ welcome }}`
		rewrite * /{{ primary }}.html
		header Cache-Control "no-store"
		file_server
	}
{%- endif %}

	handle {

{%- if activator %}
	# The pool first and the activator second, under the policy the block above explains.
	php_fastcgi {{ upstream }} {{ activator }} {
		lb_policy first
		lb_try_duration 5s
		lb_try_interval 50ms
		fail_duration 3s
	}
{%- else %}
	php_fastcgi {{ upstream }}
{%- endif %}
	file_server
	}
{%- elif kind == "static" %}
{%- if welcome %}
	# The same route a php-fpm site gets, with the index files a static site would have
	# served — roadmap task T124. `file_server` has the same shape of problem `php_fastcgi`
	# does: it is not in the group `handle` blocks form, so the condition has to be the
	# matcher's rather than the ordering's.
	@mixengine_welcome {
		path /
		not file {
			try_files index.html index.htm
		}
	}
	handle @mixengine_welcome {
		root * `{{ welcome }}`
		rewrite * /{{ primary }}.html
		header Cache-Control "no-store"
		file_server
	}
{%- endif %}

	handle {
		file_server
	}
{%- else %}
	reverse_proxy {{ upstream }}

{%- if welcome %}
	# **Nothing listening is answered rather than reported as a gateway error** — roadmap task
	# T124. `SiteKind::NodeApp` is a declaration and no more: nothing in this build starts
	# `npm run dev`, so a site on a machine that has just booted reaches this every single time.
	# What cannot be removed is the 502; what can be removed is the silence around it.
	#
	# **Every path, unlike the `handle /` the file kinds get.** A 502 Caddy generated means nothing
	# was listening, so there is no application whose answer this could be overwriting — and the
	# matcher names the two statuses rather than catching everything, so an upstream that is up and
	# said 404 still says 404.
	handle_errors 502 504 {
		root * `{{ welcome }}`
		rewrite * /{{ primary }}.html
		header Cache-Control "no-store"
		file_server
	}
{%- endif %}
{%- endif %}
{%- if authority %}
	}
{%- endif %}
}
{%- endif %}
