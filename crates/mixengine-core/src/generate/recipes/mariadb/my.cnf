# Generated by MixEngine for {{ service.id }} — do not edit.
#
# Everything here comes from the `services` row and from this instance's overrides. Edit those:
# `mix service set {{ service.id }} <key> <value>`. This file is rewritten on every start and any
# change made here is lost without ever being read.
{%- if certificate %}
#
# Rendered for certificate {{ certificate.fingerprint }} — a reissue to the same path changes this
# line, so a rewrite finds a difference and the file says which certificate it was rendered for.
{%- endif %}
#
# Every path is quoted and forward-slashed, on both counts deliberately and both measured against a
# real server in T33a: MariaDB's option parser treats `\` as an escape character and everything after
# an unquoted `#` as a comment, so a home under `C:\Users\Nguyen Hai Quang` breaks an unrendered
# path in two different ways at once.

[mysqld]
basedir = "{{ package.path | replace('\\', '/') }}"
datadir = "{{ paths.data | replace('\\', '/') }}"

# **Its own, rather than the machine's** — roadmap task **T33c**. The default is `/tmp`, which every
# MySQL-family server on the machine shares and *cleans at every start*, deleting every `#sql*` file
# it finds there whoever made it. Two of them starting a quarter second apart is one losing the
# temporary tables the other was in the middle of: measured as `Could not remove temporary table …
# error: 2` and then `[ERROR] Aborting`, one bootstrap in six. Beside the data directory rather than
# inside it, because a directory inside is a schema to this server.
tmpdir = "{{ paths.scratch | replace('\\', '/') }}"

# Stated rather than left to the default, and measured rather than assumed: on Windows mariadbd
# writes its error log to `<datadir>/<hostname>.err` and sends nothing to stdout, so a supervisor
# reading the process's own output finds an empty file and reports that the server said nothing. It
# said plenty.
log_error = "{{ paths.logs | replace('\\', '/') }}/mariadb.err"

port = {{ service.port }}
bind-address = {{ service.bind }}

# Nothing here should ever ask a DNS server whether 127.0.0.1 may connect.
skip-name-resolve

{%- if certificate %}

# **A certificate this home's authority signed, so 11.4 does not make its own** — roadmap task
# **T99**. From 11.4 the server's `ssl` option defaults to on, and a server with no certificate
# configured *generates one at every start*: a 4096-bit RSA key in `init_ssl`, between InnoDB coming
# up and the socket being created. Measured against 11.4.12 on `bench (ubuntu-latest)` as four to
# thirteen seconds of silence in `mariadb.err` at that exact point — the whole of the M3 warm start's
# spread, and why that suite read as bimodal. Naming a pair here costs the server two file reads.
# `skip-ssl` is not the answer: an 11.4 client with a password on its command line insists on TLS
# and is refused by a server without it (`ERROR 2026`), and that includes a person typing
# `mariadb -h 127.0.0.1 -p`. `ssl_cert` implies `ssl` on in every series the index publishes, so
# `ssl = on` is not written; neither is `skip-ssl`, on any path. Quoted and forward-slashed for the
# reason every path above is.
ssl_cert = "{{ certificate.path | replace('\\', '/') }}"
ssl_key = "{{ certificate.key | replace('\\', '/') }}"
{%- endif %}
{%- if paths.socket %}

# Under `run/` rather than beside the data directory: `sockaddr_un` caps a socket path at 103
# characters and the server aborts *after* InnoDB has started, which reads like a storage failure and
# is not one. `run/` is near the top of the home; a data directory is two levels down inside one
# whose name the user chose.
socket = "{{ paths.socket | replace('\\', '/') }}"
{%- endif %}
{%- if paths.plugins %}

# The plugin directory is derived from `basedir` on Unix and is not always on Windows, where the
# server has been seen looking beside its own executable instead. Stating it costs a line and turns a
# plugin that fails to load into something that cannot happen.
plugin-dir = "{{ paths.plugins | replace('\\', '/') }}"
{%- endif %}

innodb_buffer_pool_size = {{ settings.innodb_buffer_pool_size }}
max_connections = {{ settings.max_connections }}

# **A development machine's defaults from here down, which are not the server's** — roadmap task
# **T73**. Both lines exist in 10.6, the oldest series the index publishes: this parser refuses a
# whole file over one directive it does not know, so a younger line would stop the server rather
# than be ignored. `performance_schema` is not among them because MariaDB already ships it off —
# stating a default is a line to keep in step with somebody else's release for no gain.

# MyISAM's key cache, allocated at startup and held whether or not one MyISAM table exists. The
# server's own default is 128M and a PHP application written this decade has no MyISAM tables at
# all, so this is memory a laptop pays for and never reads. 16M rather than 0, because the `mysql`
# schema itself is still MyISAM on some of the series published here.
key_buffer_size = 16M

# **The log is flushed once a second rather than at every commit.** A power cut can lose about a
# second of committed transactions and cannot corrupt anything: `innodb_doublewrite` is untouched,
# and so is every other barrier that makes a torn page recoverable. What it buys is a migration or
# a seed — thousands of tiny transactions — not waiting for a disk on each one, which is the
# difference a developer feels every day. Anybody who wants the server's own guarantee writes
# `innodb_flush_log_at_trx_commit = 1` into `extra`, which renders below this and wins.
innodb_flush_log_at_trx_commit = 2

character-set-server = {{ settings.character_set }}
collation-server = {{ settings.collation }}

{{ extra }}
