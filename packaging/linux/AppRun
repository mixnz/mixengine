#!/usr/bin/env bash
# What runs when somebody executes the AppImage.
#
# **It unpacks itself before running anything, and that is not an optimisation** — the T85 design,
# D10. The AppImage runtime mounts the image on a temporary path and unmounts it when this process
# exits, so `mix`, which starts `mixengined --detach` and then returns, would tear the filesystem out
# from under the daemon it had just started; and `mixengine-elevate` beside it would be a path that
# stops resolving the next time a prompt is raised. Extracting once, keyed by version, costs a few
# tens of megabytes of cache and makes every path the daemon hands anybody a real one.
#
# Nothing is added to `PATH` and nothing is registered. A person who wants `mix` on their PATH
# symlinks the AppImage or installs the `.deb`.

set -euo pipefail

here="$(dirname "$(readlink -f "$0")")"
version="$(cat "$here/VERSION")"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/mixengine/$version"

# Copied to a temporary name and renamed into place, so two AppImages started at once never see a
# half-written binary: `mv` within one filesystem is atomic, and the loser of the race overwrites
# the winner's identical file.
#
# **Whatever `usr/bin` holds, and the guard is per file.** The AppDir holds exactly what
# `packaging/common.sh` names, so reading the directory is that list without keeping a second copy
# of it here — which is what left `mixengine-shim` out of the cache, and with it every runtime
# command, while the AppImage itself contained the file (T85c). Per file rather than once over
# `mix`, because the cache is keyed by version: a machine that ran an earlier build of this same
# version would otherwise never gain a binary a later one added.
#
# `if` rather than `[ … ] && continue`: this script runs under `set -e`, where an `&&` list whose
# left side is false is a failed command and ends it.
mkdir -p "$cache"
for packed in "$here"/usr/bin/*; do
  binary="$(basename "$packed")"
  if [ ! -x "$cache/$binary" ]; then
    cp "$packed" "$cache/$binary.$$"
    chmod 755 "$cache/$binary.$$"
    mv -f "$cache/$binary.$$" "$cache/$binary"
  fi
done

# What `ldd` says about a window this system cannot load, in the words of the person who has to fix
# it. Empty output means nothing is in the way.
#
# **Three answers and not one** — T105a, D3. What T105 shipped was `grep -q "not found"` and a
# message that always named WebKitGTK, and that is the wrong package to name on a distribution whose
# glibc is too old: `ldd` reports that case as "version `GLIBC_2.35' not found", out of the very same
# command, and the person is sent to install something they already have. ADR 0028 makes this
# message the product's whole answer to a machine below the floor, so it has to name the floor that
# was actually missed.
#
# `ldd` absent is not a refusal: the check is skipped and the dynamic loader gets to speak for
# itself.
window_refusal() {
  command -v ldd >/dev/null 2>&1 || return 0

  local binary="$1" report glibc missing others soname
  report="$(ldd "$binary" 2>&1 || true)"

  glibc="$(printf '%s\n' "$report" \
    | sed -n "s/.*version \`GLIBC_\([0-9][0-9.]*\)' not found.*/\1/p" \
    | sort -V \
    | tail -1)"
  missing="$(printf '%s\n' "$report" \
    | sed -n 's/^[[:space:]]*\([^[:space:]][^[:space:]]*\) => not found.*/\1/p' \
    | sort -u)"

  if [ -z "$glibc" ] && [ -z "$missing" ]; then
    return 0
  fi

  echo "MixLab cannot start on this system."
  echo

  if printf '%s\n' "$missing" | grep -q '^libwebkit2gtk-4\.1\.so'; then
    echo "WebKitGTK 4.1 is missing. Install it — libwebkit2gtk-4.1-0 on Debian and Ubuntu,"
    echo "webkit2gtk4.1 on Fedora and RHEL, libwebkit2gtk-4_1-0 on openSUSE."
    echo
  fi

  if [ -n "$glibc" ]; then
    echo "This distribution is older than MixLab: the window needs glibc $glibc, which arrived in"
    echo "Ubuntu 22.04, Debian 12, Fedora 38 and openSUSE Leap 15.6."
    echo
  fi

  others="$(printf '%s\n' "$missing" | grep -v '^libwebkit2gtk-4\.1\.so' | grep -v '^$' || true)"
  if [ -n "$others" ]; then
    echo "These libraries are missing:"
    printf '%s\n' "$others" | while read -r soname; do
      echo "  $soname"
    done
    echo
  fi

  echo "The .deb and the .rpm declare what MixLab needs, and your package manager installs it."
  echo "The command line inside this same file is unaffected: run it with an argument, e.g."
  echo "  $0 status"
}

# The same words, where a double click can read them.
#
# **A person who double-clicked an AppImage in a file manager has no terminal attached** — T105a,
# D3. Everything above goes to stderr, which for exactly the person this message was written for
# goes nowhere: what they see is a window that never appears. Nothing here is downloaded and nothing
# becomes a dependency — whichever of the three is already installed is used, the text is passed as
# one argument and never through a shell, and none of them being installed is stderr only.
show_refusal_dialog() {
  local text="$1"
  [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] || return 0

  if command -v zenity >/dev/null 2>&1; then
    zenity --error --title="MixLab" --text="$text" >/dev/null 2>&1 || true
  elif command -v kdialog >/dev/null 2>&1; then
    kdialog --title "MixLab" --error "$text" >/dev/null 2>&1 || true
  elif command -v xmessage >/dev/null 2>&1; then
    xmessage -center "$text" >/dev/null 2>&1 || true
  fi
}

# **What this image does when it is given nothing to do** — T105, D6. A double click in a file
# manager passes no arguments and should open MixLab; `./mixengine-<version>-linux-x86_64.AppImage
# status` passes one and has to stay the CLI it has always been. The AppImage runtime consumes its
# own `--appimage-*` arguments before this script is reached, so neither branch ever sees one.
if [ "$#" -eq 0 ]; then
  # **This image does not carry WebKitGTK, and since ADR 0028 that is a decision rather than an
  # interim.** Every distribution new enough to run this window already packages the library; the
  # one family that does not is one whose glib is too old for it as well, so carrying WebKitGTK
  # there would mean carrying the platform. What is worth doing here is refusing in words: without
  # this, a person below the floor gets a linker message about a soname, which names no package they
  # could install — and, from a file manager, gets nothing at all.
  refusal="$(window_refusal "$cache/mixlab")"
  if [ -n "$refusal" ]; then
    printf '%s\n' "$refusal" >&2
    show_refusal_dialog "$refusal"
    exit 1
  fi

  exec "$cache/mixlab"
fi

exec "$cache/mix" "$@"
